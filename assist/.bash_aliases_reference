#kill 功能
ki() {
	# 检查是否提供了关键字参数
	if [ $# -eq 0 ]; then
		echo "Usage: $0 <process_keyword>"
		exit 1
	fi

	# 将关键字参数赋值给变量
	keyword=$1

	# 查找所有包含关键字的进程
	processes=$(ps -ef | grep "$keyword" | grep -v grep | awk '{print $2}')

	# 遍历进程号并杀掉它们
	for pid in $processes; do
		echo "Killing process with PID: $pid"
		kill -9 "$pid"
	done

	echo "All processes containing '$keyword' have been terminated." 
}




