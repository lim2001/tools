# 定义一个函数来检查配置文件是否被修改
check_and_reload_zshrc() {
    local zshrc_file="$HOME/.bash_aliases"
    local zshrc_last_modified_time

    # 获取配置文件的最后修改时间
    zshrc_last_modified_time=$(stat -c %Y "$zshrc_file" 2>/dev/null || stat -f %m "$zshrc_file" 2>/dev/null)

    # 如果变量不存在，初始化它
    if [[ -z "$ZSHRC_LAST_MODIFIED_TIME" ]]; then
        export ZSHRC_LAST_MODIFIED_TIME=$zshrc_last_modified_time
    fi

    # 检查配置文件是否被修改
    if [[ "$zshrc_last_modified_time" -gt "$ZSHRC_LAST_MODIFIED_TIME" ]]; then
        # 重新加载配置文件
        source ~/.zshrc
        export ZSHRC_LAST_MODIFIED_TIME=$zshrc_last_modified_time
        echo "配置文件已重新加载。"
    fi
}

