function preexec() {
	local cmd=$1
	python3  $ORBBEC_SHELL_PATH "$cmd"
	process_command=$?  
	return 0
}

function command_not_found_handler() {
    local input="$1"
    if [[ -f "$input" && "$input" == *.py ]]; then
        python_file=$input
		echo "python $python_file" 
        python "$python_file"
		return 0  #返回0 命令已处理
    fi

	if [[ $process_command -eq 0 ]]; then
		echo "command not found:  $input" 
		return 1
	fi
}
